<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut badge: fixed brand circle + white Symbols glyph.
     Fixed colors only (no ?attr): inflated by the launcher process. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <solid android:color="@color/colorPrimary" />
    </shape>
  </item>
  <item
    android:width="24dp"
    android:height="24dp"
    android:gravity="center"
    android:drawable="@drawable/ic_touch_glyph_white" />
</layer-list>
