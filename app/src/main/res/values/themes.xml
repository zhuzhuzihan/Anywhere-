<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Platform.V23.Theme.Anywhere" parent="Theme.Material3Expressive.Light.Anywhere" />

  <style name="Platform.Theme.Anywhere" parent="Platform.V23.Theme.Anywhere" />

  <style name="Base.AppTheme" parent="Platform.Theme.Anywhere">
    <item name="preferenceTheme">@style/PreferenceThemeOverlay.Rikka.Material3</item>
    <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialog</item>
    <item name="dropDownListViewStyle">@style/Widget.Aw.PopupMenu</item>

    <!-- M3 Expressive defaults (explicit so the intent survives theme-overlay changes).
         Only verified 1.14.0 style names are listed; the base
         Theme.Material3Expressive.* already supplies expressive defaults
         for search/slider/progress/topAppBar/navigation. -->
    <item name="materialButtonStyle">@style/Widget.Material3Expressive.Button</item>
    <item name="materialButtonOutlinedStyle">@style/Widget.Material3Expressive.Button.OutlinedButton</item>
    <item name="materialButtonTonalStyle">@style/Widget.Material3Expressive.Button.TonalButton</item>
    <item name="borderlessButtonStyle">@style/Widget.Material3Expressive.Button.TextButton</item>
    <item name="floatingActionButtonStyle">@style/Widget.Material3Expressive.FloatingActionButton</item>
    <item name="extendedFloatingActionButtonStyle">@style/Widget.Material3Expressive.ExtendedFloatingActionButton.Medium</item>
    <item name="materialButtonToggleGroupStyle">@style/Widget.Material3Expressive.MaterialButtonToggleGroup</item>

    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>

    <!-- Background wash: M3E container tint (FolkPatch-style dynamic look).
         surfaceContainerLow carries the wallpaper seed hue subtly; Filled
         cards sit one level above it. Do NOT use primaryContainer here —
         full-screen pastel is too loud. -->
    <item name="android:windowBackground">?attr/colorSurfaceContainerLow</item>

    <item name="bottomSheetHeaderHandlerColor">@color/bottom_sheet_header_handler</item>
    <item name="bottomSheetHeaderHandlerColorActivated">@color/bottom_sheet_header_handler_activated</item>

    <!-- App-owned alias of ?attr/colorPrimary (see attrs.xml). -->
    <item name="awColorPrimary">?attr/colorPrimary</item>
  </style>

  <style name="Theme" parent="Base.AppTheme" />

</resources>
