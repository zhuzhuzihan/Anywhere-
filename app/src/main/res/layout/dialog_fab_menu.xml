<?xml version="1.0" encoding="utf-8"?>
<!-- M3 replacement for the SpeedDial expandable menu: a modal bottom sheet
     with one-line list rows (24dp icon + BodyLarge label, 56dp rows).
     Row clicks report R.id.fab_* ids so MainActivity logic is unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingTop="8dp"
  android:paddingBottom="16dp">

  <LinearLayout
    android:id="@+id/row_advanced"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_advanced_card" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:text="@string/btn_add_advanced_card"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_collector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_logo" />

    <TextView
      android:id="@+id/tv_collector_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_activity_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_activity_list" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:text="@string/btn_activity_list"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_qr_code"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_qr_code" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:text="@string/btn_qr_code_collection"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_cloud_rules"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_cloud_backup" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:text="@string/btn_cloud_rules"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_shortcut"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:tint="?attr/colorOnSurfaceVariant"
      app:srcCompat="@drawable/ic_add_shortcut" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:text="@string/btn_third_apps_shortcut"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

  </LinearLayout>

</LinearLayout>
